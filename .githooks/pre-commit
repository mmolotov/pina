#!/bin/sh
# Fast pre-commit gate: formatting + lint on what's staged. CI runs the full suite.
# Bypass in an emergency with: git commit --no-verify
# Enable once per clone with:  git config core.hooksPath .githooks
set -u

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
status=0

if printf '%s\n' "$staged" | grep -q '^backend/.*\.java$'; then
  echo "› backend: spotlessCheck"
  if ! (cd backend && ./gradlew spotlessCheck -q); then
    echo "✗ Backend formatting failed. Fix: (cd backend && ./gradlew spotlessApply)" >&2
    status=1
  fi
fi

if printf '%s\n' "$staged" | grep -qE '^frontend/.*\.(ts|tsx|js|mjs|css|json|md)$'; then
  echo "› frontend: format:check + lint + stylelint"
  if ! (cd frontend && npm run format:check && npm run lint && npm run stylelint); then
    echo "✗ Frontend checks failed. Fix: (cd frontend && npm run format)" >&2
    status=1
  fi
fi

if printf '%s\n' "$staged" | grep -q '^ml/.*\.py$'; then
  echo "› ml: ruff check + format"
  if ! (cd ml && uv run ruff check . && uv run ruff format --check .); then
    echo "✗ ML lint/format failed. Fix: (cd ml && make format)" >&2
    status=1
  fi
fi

[ "$status" -ne 0 ] && echo "Pre-commit failed. Bypass with 'git commit --no-verify'." >&2
exit "$status"
