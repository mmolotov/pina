{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(cd backend && ./gradlew *)",
      "Bash(npm run *)",
      "Bash(cd frontend && npm run *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm audit *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx stylelint *)",
      "Bash(npx playwright *)",
      "Bash(npx react-router *)",
      "Bash(make *)",
      "Bash(cd ml && make *)",
      "Bash(uv run *)",
      "Bash(cd ml && uv run *)",
      "Bash(buf *)",
      "Bash(cd proto && buf *)",
      "Bash(docker compose *)",
      "Bash(cd backend)",
      "Bash(cd frontend)",
      "Bash(cd ml)",
      "Bash(cd proto)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(awk *)",
      "Bash(sed -n *)",
      "Bash(xargs *)",
      "Bash(trivy *)",
      "mcp__backlog__task_list",
      "mcp__backlog__task_view",
      "mcp__backlog__task_search",
      "mcp__backlog__task_create",
      "mcp__backlog__task_edit",
      "mcp__backlog__task_complete",
      "mcp__backlog__milestone_list",
      "mcp__backlog__get_backlog_instructions"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  },
  "enabledMcpjsonServers": ["backlog"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-writes.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/collect-touched.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
