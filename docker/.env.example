# Docker Compose environment variables for PINA
# Copy this file to .env and adjust values for your setup.
#
# WARNING: The defaults below are for local development only.
# Change all credentials before deploying to production!

POSTGRES_DB=pina
POSTGRES_USER=pina
POSTGRES_PASSWORD=pina

# Permissive CORS for local dev (localhost / 127.0.0.1 / LAN IP, any port).
# Reflects any Origin — with allow-credentials this must NEVER run on a shared
# or production host; set an explicit allow-list of real frontend origins there.
QUARKUS_HTTP_CORS_ORIGINS=/.*/
